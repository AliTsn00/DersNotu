{
  "name": "ders-notu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Derste hocanın sesini dinleyip Türkçe'ye uygun, maddeli ders notuna çeviren PWA",
  "browserslist": [
    "last 3 Chrome versions",
    "last 3 Firefox versions",
    "last 3 Safari versions",
    "last 3 Edge versions",
    "iOS >= 15.4",
    "not dead"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:tek": "vite build --config vite.tekdosya.config.js && node scripts/tek-dosya.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4.2.2",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^4.1.5"
  }
}
